# ARCHITECTURAL GATEKEEPER: .gitignore
# Role: Defines exclusion patterns for the Tessera Enterprise repository.
# Integration: Enforces Zero-Leak Sandbox compliance by preventing sensitive runtime state,
# diagnostic logs, and local module caches from entering the version control system.

# Python Runtime & Build Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing & Diagnostic Infrastructure
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.diagnostic_cache/

# Tessera Enterprise Runtime State (CRITICAL: Never Commit)
memory/
modules/*/.cache/
modules/*/.state/
*.log
*.diagnostic.json
.env
.env.local
.env.*.local

# OS & System Junk
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Security & PII Protection
*.key
*.pem
*.secret
*.vault
*.bak

# Diagnostic Engine Telemetry Artifacts
telemetry_data/
*.diag.log
*.report.json