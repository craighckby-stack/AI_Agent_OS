# ==============================================================================
# TESSERA ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your values. All keys are optional —
# Tessera runs in keyword-only mode (no LLM calls) if no provider keys
# are set, falling back to the ROUTING_TABLE in kernel.py.
# ==============================================================================

# --- LLM PROVIDER CONFIGURATION ---
# The router tries these in order: Gemini -> OpenAI -> DeepSeek -> Local.
# Missing keys are skipped; partial setups are fully supported.
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# --- LOCAL MODEL OVERRIDES ---
# Used as the final LLM fallback (e.g. Ollama, LM Studio, llama.cpp server).
LOCAL_LLM_URL=http://localhost:11434/api/generate
LOCAL_LLM_MODEL=llama3.2

# --- CACHE CONFIGURATION ---
# Cache backend: "file" (default, zero-dep) or "redis" (enterprise).
TESSERA_CACHE_BACKEND=file
# For file backend: directory for cache files.
TESSERA_CACHE_DIR=./memory/local
# For redis backend: connection URL.
# TESSERA_CACHE_REDIS_URL=redis://localhost:6379/0
# Confidence threshold for cache hits (0-100). Entries below this are ignored.
TESSERA_CACHE_CONFIDENCE_THRESHOLD=90
# TTL for cache entries in seconds (0 = no expiry).
TESSERA_CACHE_TTL=0

# --- ROUTER CACHE ---
# Enable caching of routing decisions (drops break-even hit rate to ~20%).
TESSERA_ROUTER_CACHE_ENABLED=true

# --- MODULES ---
# Directory containing module folders. Each module has a README.md and run.sh.
TESSERA_MODULES_DIR=./modules

# --- DEBUGGING & TELEMETRY ---
# Enable verbose kernel execution logs.
DEBUG_MODE=false
# Endpoint for remote telemetry (optional).
TELEMETRY_ENDPOINT=

# --- SYSTEM INTEGRITY ---
# Enforce strict module registry validation.
STRICT_MODE=true
# Diagnostic heartbeat interval (seconds).
DIAGNOSTIC_INTERVAL=300
