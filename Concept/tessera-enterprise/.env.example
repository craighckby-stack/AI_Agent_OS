# ==============================================================================
# TESSERA ENTERPRISE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Role: Defines the global configuration schema, system thresholds, and security
# boundaries for the Tessera Enterprise Kernel.
# Integration: Copied to `.env` at runtime; validated by the Diagnostic Engine
# (`lib/env-validator.ts`) during the pre-boot phase.
# ==============================================================================

# --- LLM PROVIDER CONFIGURATION ---
# The router tries these in order: Gemini -> OpenAI -> DeepSeek -> Local.
# Missing keys are skipped; partial setups are fully supported.
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# --- LOCAL MODEL OVERRIDES ---
# Used as the final LLM fallback (e.g. Ollama, LM Studio, llama.cpp server).
LOCAL_LLM_URL=http://localhost:11434/api/generate
LOCAL_LLM_MODEL=llama3.2

# --- CACHE CONFIGURATION ---
# Cache backend: "file" (default, zero-dep) or "redis" (enterprise).
TESSERA_CACHE_BACKEND=file
# For file backend: directory for cache files.
TESSERA_CACHE_DIR=./memory/local
# For redis backend: connection URL.
# TESSERA_CACHE_REDIS_URL=redis://localhost:6379/0
# Confidence threshold for cache hits (0-100). Entries below this are ignored.
TESSERA_CACHE_CONFIDENCE_THRESHOLD=90
# TTL for cache entries in seconds (0 = no expiry).
TESSERA_CACHE_TTL=0

# --- ROUTER CACHE ---
# Enable caching of routing decisions (drops break-even hit rate to ~20%).
TESSERA_ROUTER_CACHE_ENABLED=true

# --- MODULES ---
# Directory containing module folders. Each module has a README.md and run.sh.
TESSERA_MODULES_DIR=./modules

# --- ZERO-LEAK SANDBOX CONFIGURATION ---
# Enforce WeakMap-based memory tracking to prevent agent execution memory leaks.
TESSERA_SANDBOX_USE_WEAKMAPS=true
# Maximum memory allocation per sandboxed agent execution (in MB).
TESSERA_SANDBOX_MAX_MEMORY_MB=128
# Hard timeout for sandboxed agent execution (in milliseconds).
TESSERA_SANDBOX_TIMEOUT_MS=5000

# --- DYNAMIC CONSENSUS WEIGHTING ---
# Strategy for resolving multi-agent conflicts: "dynamic", "static", or "bayesian".
TESSERA_CONSENSUS_STRATEGY=dynamic
# Minimum number of active agents required to establish consensus.
TESSERA_CONSENSUS_MIN_AGENTS=3
# Decay rate for consensus weights of underperforming agents (0.0 - 1.0).
TESSERA_CONSENSUS_DECAY_RATE=0.1

# --- MULTI-AGENT ORCHESTRATION & QUEUE ---
# Maximum concurrent agents running in parallel.
TESSERA_MAX_CONCURRENT_AGENTS=10
# Maximum task queue size before rejecting incoming requests.
TESSERA_MAX_QUEUE_SIZE=100
# Backoff strategy for failed agent executions: "exponential", "linear", or "none".
TESSERA_BACKOFF_STRATEGY=exponential
# Base delay for backoff strategy in milliseconds.
TESSERA_BACKOFF_BASE_DELAY_MS=1000

# --- VECTOR DATABASE INTEGRATION ---
# Vector DB provider: "none" (default), "chroma", "pinecone", or "qdrant".
TESSERA_VECTOR_DB=none
# Connection URL or endpoint for the vector database.
TESSERA_VECTOR_DB_URL=http://localhost:8000
# API key for cloud-hosted vector databases (e.g. Pinecone).
TESSERA_VECTOR_DB_API_KEY=
# Dimension size for embeddings (e.g., 1536 for text-embedding-3-small).
TESSERA_VECTOR_DB_DIMENSION=1536

# --- SECURITY & ENCRYPTION ---
# Secret key used for encrypting sensitive agent memory and API keys at rest (min 32 chars).
TESSERA_ENCRYPTION_KEY=
# Allowed CORS origins for the API server (comma-separated).
TESSERA_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- DEBUGGING & TELEMETRY ---
# Enable verbose kernel execution logs.
DEBUG_MODE=false
# Endpoint for remote telemetry (optional).
TELEMETRY_ENDPOINT=
# Level of telemetry detail: "error", "warn", "info", "debug".
TELEMETRY_LEVEL=info
# Prometheus metrics export port (optional).
PROMETHEUS_METRICS_PORT=9090

# --- SYSTEM INTEGRITY & DIAGNOSTICS ---
# Enforce strict module registry and environment validation on startup.
STRICT_MODE=true
# Diagnostic heartbeat interval (seconds).
DIAGNOSTIC_INTERVAL=300
# Path to write diagnostic health reports.
TESSERA_DIAGNOSTIC_LOG_PATH=./logs/diagnostics.json
# Enable high-fidelity telemetry tracking for diagnostic engine.
DIAGNOSTIC_TELEMETRY_ENABLED=true
# Diagnostic registry verification mode: "strict" or "permissive".
DIAGNOSTIC_REGISTRY_MODE=strict
# Maximum allowed memory leak threshold before triggering diagnostic alerts (in MB).
DIAGNOSTIC_MEMORY_LEAK_THRESHOLD_MB=50