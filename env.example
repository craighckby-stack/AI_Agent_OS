# Copy this file to .env and fill in whichever keys you have.
# Kernel tries them in this order: Gemini -> OpenAI -> DeepSeek -> local model.
# Missing keys are skipped, not treated as errors — set as many or as few as you like.
# If none are set, or all calls fail, the kernel falls back to keyword routing.

GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Local model (e.g. Ollama running via Termux on-device). Only used if the
# above three are unset or fail. Defaults shown below.
LOCAL_LLM_URL=http://localhost:11434/api/generate
LOCAL_LLM_MODEL=llama3.2
