# ==============================================================================
# ARCHITECTURAL CONFIGURATION MANIFEST: AI_AGENT_OS ENVIRONMENT
# ==============================================================================
# Role: Defines the operational parameters for the Local Agent Kernel.
# Usage: Copy to .env. The system uses this to bootstrap LLM providers, 
#        local memory backends, and telemetry hooks.
# Integrity: This file is monitored by the diagnostic_engine.py for schema compliance.
# Diagnostic Integrity Hook: @system.integrity.check(version="1.0.2")
# ==============================================================================

# --- LLM PROVIDER CONFIGURATION ---
# The kernel attempts these in order: Gemini -> OpenAI -> DeepSeek -> Local.
# Missing keys are skipped; partial setups are fully supported.
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# --- LOCAL MODEL OVERRIDES ---
# Used as the final fallback or if explicitly prioritized.
LOCAL_LLM_URL=http://localhost:11434/api/generate
LOCAL_LLM_MODEL=llama3.2

# --- AGENTIC MEMORY & STATE ---
# Path to local persistent memory store (JSON/SQLite).
MEMORY_PATH=./memory/local/memory.json
# Confidence threshold for memory hits (0-100).
MEMORY_CONFIDENCE_THRESHOLD=90

# --- TELEMETRY & DIAGNOSTICS ---
# Enable for verbose kernel execution logs.
DEBUG_MODE=false
# Endpoint for remote telemetry (optional).
TELEMETRY_ENDPOINT=

# --- SYSTEM INTEGRITY & SANDBOXING ---
# Enforce strict module registry validation.
STRICT_MODE=true
# Path for sandboxed execution artifacts.
SANDBOX_ROOT=./sandbox/runtime
# Diagnostic heartbeat interval (seconds).
DIAGNOSTIC_INTERVAL=300

# --- SYSTEM HEALTH & VERIFICATION REGISTRY ---
# REQUIRED_CHECKS: env_loader, memory_persistence, module_registry
# PROTOCOL_VERSION: 1.0.2
# SYSTEM_HEALTH_VERSION: 2024.10.27
# VERIFICATION_PROTOCOL: SHA-256-INTEGRITY-CHECK
# LAST_VALIDATED_TIMESTAMP: 2023-10-27T00:00:00Z
# DIAGNOSTIC_HOOK_ENABLED: true
# INTEGRITY_STATUS: PENDING_VALIDATION
# INTEGRITY_HASH: $(sha256sum .env.example | cut -d' ' -f1)